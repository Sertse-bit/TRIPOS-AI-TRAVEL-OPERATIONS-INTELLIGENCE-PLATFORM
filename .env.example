# Copy this file to .env.local and fill in real values.
# Never commit .env or .env.local — see .gitignore.
# These are server-side only. Never prefix any of these with NEXT_PUBLIC_,
# which would expose them to the browser bundle.

# ─── Core Infrastructure ───────────────────────────────────────────────────

NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/tripos_dev

# Redis connection string
REDIS_URL=redis://localhost:6379

# Session signing secret — must be at least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# ─── AI ─────────────────────────────────────────────────────────────────────

ANTHROPIC_API_KEY=

# ─── External API Providers ────────────────────────────────────────────────

# Aviationstack — flight status, flight details, airline/airport info
AVIATIONSTACK_API_KEY=

# Weatherstack — current weather, destination conditions
WEATHERSTACK_API_KEY=

# Fixer — exchange rates (primary currency provider)
FIXER_API_KEY=

# ExchangeRate (apilayer exchangerates_data) — exchange rates (fallback
# currency provider; paired with Fixer to demonstrate provider fallback)
EXCHANGERATE_API_KEY=

# IPstack — approximate client geolocation
IPSTACK_API_KEY=

# Numverify — phone number validation
NUMVERIFY_API_KEY=

# Zenserp — search/research agent
ZENSERP_API_KEY=

# Filestack — file upload and document intake
FILESTACK_API_KEY=

# Screenshotlayer — webpage screenshots (only wired up if a real feature
# needs it, per project rules — no integration without a justified use case)
SCREENSHOTLAYER_API_KEY=

# Mailboxlayer — email validation (planned use: registration flow, Phase 4)
MAILBOXLAYER_API_KEY=

# Marketstack — stock market data. NOT currently mapped to a TripOS feature.
# Left available but unused until a real use case is identified — see
# docs/BUILD_PROGRESS.md. Do not wire this up "because it's available."
MARKETSTACK_API_KEY=
