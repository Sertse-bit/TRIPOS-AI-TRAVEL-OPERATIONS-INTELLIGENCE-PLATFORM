// TripOS database schema.
//
// Naming convention: PascalCase singular model names (Prisma idiom),
// mapped to snake_case plural table names via @@map -- see docs/DATABASE.md
// for the full rationale behind every modeling decision in this file.
//
// NOTE ON SANDBOX VALIDATION: `prisma generate`/`migrate`/`validate` could
// not be executed in the build sandbox -- Prisma's CLI fetches its schema
// engine binary from binaries.prisma.sh at runtime, which is outside the
// sandbox's network allowlist (confirmed on both Prisma 7 and 6; not a
// version-specific issue). This is a sandbox-only limitation: any normal
// dev machine, CI runner, or Docker build has standard internet access and
// will run these commands fine. To still validate the actual relational
// design for real, this schema's DDL was hand-translated and applied
// directly to a live local PostgreSQL 16 + pgvector instance via psql --
// see docs/DATABASE.md for that verification.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// --- Enums ------------------------------------------------------------

enum Role {
  USER
  ADMIN
}

enum TripStatus {
  PLANNING
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum FlightStatus {
  UNKNOWN
  SCHEDULED
  DELAYED
  CANCELLED
  LANDED
  COMPLETED
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
}

enum RiskSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RecommendationStatus {
  PENDING
  ACKNOWLEDGED
  DISMISSED
}

enum ActorType {
  USER
  SYSTEM
  AI_AGENT
}

enum ApiHealthStatus {
  OPERATIONAL
  DEGRADED
  DOWN
}

enum ItineraryItemType {
  FLIGHT
  LODGING
  ACTIVITY
  TRANSPORT
  MEAL
  OTHER
}

/// Distinguishes the two writers of a plan. A re-plan replaces the
/// AI_PLANNER rows and leaves the traveler's own items untouched --
/// regenerating a schedule must never silently delete something the
/// traveler typed in themselves.
enum ItineraryItemSource {
  USER
  AI_PLANNER
}

// --- Auth ---------------------------------------------------------------

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String    @map("password_hash")
  name            String
  role            Role      @default(USER)
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  trips         Trip[]
  documents     TripDocument[]
  notifications Notification[]
  sessions      Session[]

  @@map("users")
}

/// Deliberately NOT using the full Auth.js/NextAuth Prisma-adapter schema
/// (User/Account/Session/VerificationToken) -- Account and VerificationToken
/// exist to support OAuth and email-link providers, neither of which
/// TripOS uses (credentials-only auth per docs/ARCHITECTURE.md Section 12).
/// This minimal Session table gives full control over revocation and
/// stores a hash of the session token rather than the token itself, the
/// same principle as password hashing: never store a live secret in
/// plaintext, even server-side.
model Session {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// --- Trip Digital Twin ---------------------------------------------------

model Trip {
  id        String     @id @default(uuid())
  userId    String     @map("user_id")
  title     String
  status    TripStatus @default(PLANNING)
  startDate DateTime?  @map("start_date")
  endDate   DateTime?  @map("end_date")
  /// Optional budget cap (Phase 20) the itinerary's costs are validated
  /// against, in `budgetCurrency`. Null means no cap; the two columns are
  /// always set or cleared together (CHECK constraint in
  /// prisma/sql/phase-20-itinerary-planner.sql). Deliberately on the trip,
  /// not on the plan: it is a property of the trip itself.
  budgetAmount   Decimal? @map("budget_amount") @db.Decimal(12, 2)
  budgetCurrency String?  @map("budget_currency") @db.Char(3)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  travelers         Traveler[]
  destinations      Destination[]
  flightRecords     FlightRecord[]
  currencySnapshots CurrencySnapshot[]
  documents         TripDocument[]
  riskAssessments   RiskAssessment[]
  recommendations   Recommendation[]
  events            TripEvent[]
  watch             TripWatch?
  itineraryItems    ItineraryItem[]

  @@index([userId])
  @@map("trips")
}

model Traveler {
  id          String    @id @default(uuid())
  tripId      String    @map("trip_id")
  fullName    String    @map("full_name")
  dateOfBirth DateTime? @map("date_of_birth")
  /// Passport numbers are sensitive PII. Flagged in docs/SECURITY.md
  /// (Phase 4) as a field that needs encryption-at-rest / access
  /// auditing before any real user data is stored -- not implemented yet,
  /// documented rather than silently deferred.
  passportNumber String? @map("passport_number")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("travelers")
}

model Destination {
  id            String    @id @default(uuid())
  tripId        String    @map("trip_id")
  city          String
  country       String
  latitude      Decimal?  @db.Decimal(9, 6)
  longitude     Decimal?  @db.Decimal(9, 6)
  arrivalDate   DateTime? @map("arrival_date")
  departureDate DateTime? @map("departure_date")
  /// Sequences multi-city trips; not a DB-enforced order, just display/logic order.
  orderIndex    Int       @default(0) @map("order_index")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  trip             Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  weatherSnapshots WeatherSnapshot[]
  itineraryItems   ItineraryItem[]

  @@index([tripId])
  @@map("destinations")
}

model FlightRecord {
  id                 String   @id @default(uuid())
  tripId             String   @map("trip_id")
  flightNumber       String   @map("flight_number")
  airline            String
  departureAirport   String   @map("departure_airport")
  arrivalAirport     String   @map("arrival_airport")
  scheduledDeparture DateTime @map("scheduled_departure")
  scheduledArrival   DateTime @map("scheduled_arrival")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  trip      Trip                   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  snapshots FlightStatusSnapshot[]

  @@index([tripId])
  @@map("flight_records")
}

/// Justified addition beyond the brief's starting entity list: flight
/// state changes over time and the Flight Agent (Phase 10) must "compare
/// current state against previous snapshot" -- that requires an
/// append-only history, not a single mutable status column on
/// FlightRecord. Matches the Data Flow diagram in docs/ARCHITECTURE.md
/// Section 7.
model FlightStatusSnapshot {
  id                  String       @id @default(uuid())
  flightRecordId      String       @map("flight_record_id")
  status              FlightStatus @default(UNKNOWN)
  actualDeparture     DateTime?    @map("actual_departure")
  actualArrival       DateTime?    @map("actual_arrival")
  delayMinutes        Int?         @map("delay_minutes")
  /// The raw provider payload, kept for audit/debugging -- the brief is
  /// explicit that external API data must be the source, never invented;
  /// keeping the raw response makes that checkable after the fact.
  rawProviderResponse Json?        @map("raw_provider_response")
  fetchedAt           DateTime     @map("fetched_at")
  createdAt           DateTime     @default(now()) @map("created_at")

  flightRecord FlightRecord @relation(fields: [flightRecordId], references: [id], onDelete: Cascade)

  @@index([flightRecordId, fetchedAt])
  @@map("flight_status_snapshots")
}

model WeatherSnapshot {
  id                  String   @id @default(uuid())
  destinationId       String   @map("destination_id")
  temperatureCelsius  Decimal  @map("temperature_celsius") @db.Decimal(5, 2)
  condition           String
  windSpeedKph        Decimal? @map("wind_speed_kph") @db.Decimal(5, 2)
  precipitationMm     Decimal? @map("precipitation_mm") @db.Decimal(6, 2)
  rawProviderResponse Json?    @map("raw_provider_response")
  fetchedAt           DateTime @map("fetched_at")
  createdAt           DateTime @default(now()) @map("created_at")

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([destinationId, fetchedAt])
  @@map("weather_snapshots")
}

model CurrencySnapshot {
  id             String   @id @default(uuid())
  tripId         String   @map("trip_id")
  baseCurrency   String   @map("base_currency") @db.Char(3)
  targetCurrency String   @map("target_currency") @db.Char(3)
  rate           Decimal  @db.Decimal(18, 8)
  /// Which provider answered -- Fixer and ExchangeRate are both
  /// configured (see docs/BUILD_PROGRESS.md) specifically so one can be
  /// the fallback for the other per the resilience design (Phase 6).
  provider            String
  rawProviderResponse Json?    @map("raw_provider_response")
  fetchedAt           DateTime @map("fetched_at")
  createdAt           DateTime @default(now()) @map("created_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, fetchedAt])
  @@map("currency_snapshots")
}

// --- Document Intelligence / RAG -----------------------------------------

model TripDocument {
  id                String         @id @default(uuid())
  tripId            String         @map("trip_id")
  uploadedBy        String         @map("uploaded_by")
  originalFilename  String         @map("original_filename")
  storageKey        String         @map("storage_key")
  mimeType          String         @map("mime_type")
  sizeBytes         Int            @map("size_bytes")
  status            DocumentStatus @default(UPLOADED)
  failureReason     String?        @map("failure_reason")
  /// Full text extracted by the Phase 14 pipeline (PDF text layer). Null
  /// until extraction succeeds; Phase 15 chunking/embedding reads from
  /// this rather than re-parsing the original file.
  extractedText     String?        @map("extracted_text")
  /// Semi-structured, varies by document type (passenger, flight number,
  /// booking reference, etc. per Phase 14) -- a JSONB column is the right
  /// normalization call here, not a rigid table of fixed columns, since
  /// which fields exist depends on what was actually extracted.
  extractedMetadata Json?          @map("extracted_metadata")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  trip     Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  uploader User            @relation(fields: [uploadedBy], references: [id])
  chunks   DocumentChunk[]

  @@index([tripId])
  @@map("trip_documents")
}

/// Embedding dimension is now decided (Phase 15): Voyage AI's
/// `voyage-3` model emits 1024-dimension vectors, so the column is
/// `vector(1024)`. The earlier 1536 placeholder was explicitly
/// provisional pending exactly this choice, and Anthropic has no
/// embeddings endpoint, so a separate provider was always required.
///
/// The vector index (HNSW / cosine) is created with raw SQL rather than
/// declared here -- see docs/DATABASE.md for the exact statement. It is
/// kept out of this file because Prisma's vector-index support could not
/// be validated in this environment, and shipping schema syntax that was
/// never executed would trade a real check for a cosmetic one.
model DocumentChunk {
  id             String                       @id @default(uuid())
  tripDocumentId String                       @map("trip_document_id")
  chunkIndex     Int                          @map("chunk_index")
  content        String
  embedding      Unsupported("vector(1024)")?
  tokenCount     Int?                         @map("token_count")
  createdAt      DateTime                     @default(now()) @map("created_at")

  document TripDocument @relation(fields: [tripDocumentId], references: [id], onDelete: Cascade)

  @@index([tripDocumentId])
  @@map("document_chunks")
}

// --- Risk & Recommendations ----------------------------------------------

model RiskAssessment {
  id          String       @id @default(uuid())
  tripId      String       @map("trip_id")
  riskScore   Int          @map("risk_score")
  severity    RiskSeverity
  /// Deterministic factor breakdown (flight/weather/schedule/document
  /// completeness weights) -- the domain model owns this, never an LLM
  /// free-inventing a score. See docs/ARCHITECTURE.md and Phase 16.
  factors     Json
  evidence    Json
  confidence  Decimal      @db.Decimal(3, 2)
  generatedAt DateTime     @map("generated_at")
  createdAt   DateTime     @default(now()) @map("created_at")

  trip            Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  recommendations Recommendation[]

  @@index([tripId])
  @@map("risk_assessments")
}

model Recommendation {
  id                 String               @id @default(uuid())
  tripId             String               @map("trip_id")
  riskAssessmentId   String?              @map("risk_assessment_id")
  /// The four-part explainable-AI structure required by Phase 17.
  decision           String
  evidence           Json
  reasoningSummary   String               @map("reasoning_summary")
  recommendationText String               @map("recommendation_text")
  confidence         Decimal              @db.Decimal(3, 2)
  status             RecommendationStatus @default(PENDING)
  createdAt          DateTime             @default(now()) @map("created_at")

  trip           Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  riskAssessment RiskAssessment? @relation(fields: [riskAssessmentId], references: [id])

  @@index([tripId])
  @@index([riskAssessmentId])
  @@map("recommendations")
}

// --- Events, Notifications, Audit -----------------------------------------

/// eventType is a plain string (validated at the application layer via a
/// Zod union), not a Postgres enum -- new event types are expected to be
/// added across many future phases, and a string column avoids a schema
/// migration every time one is. TripStatus/FlightStatus etc. above are
/// proper enums because those sets are small and stable by contrast.
model TripEvent {
  id         String   @id @default(uuid())
  tripId     String   @map("trip_id")
  eventType  String   @map("event_type")
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  metadata   Json?
  /// Idempotency key per docs/ARCHITECTURE.md Section 9: entity id plus
  /// the snapshot id that triggered the event, so a worker retry or
  /// duplicate delivery is a safe no-op, not a duplicate notification.
  dedupeKey  String   @unique @map("dedupe_key")
  createdAt  DateTime @default(now()) @map("created_at")

  trip          Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([tripId, createdAt])
  @@map("trip_events")
}

model Notification {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  tripEventId String?   @map("trip_event_id")
  title       String
  body        String
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripEvent TripEvent? @relation(fields: [tripEventId], references: [id])

  @@index([userId, readAt])
  @@map("notifications")
}

/// One scheduled element of a trip's day-by-day plan (Phase 20), owned by
/// the itinerary module.
///
/// `estimatedCost` is only ever a figure the traveler supplied (or, later,
/// one extracted from a real uploaded document) -- the planning agent's
/// output schema has no cost fields at all, so an LLM-generated price
/// estimate cannot reach this column even accidentally. See
/// docs/BUILD_PROGRESS.md's Phase 20 entry.
model ItineraryItem {
  id String @id @default(uuid())

  tripId String @map("trip_id")
  /// A calendar day, deliberately `date` rather than `timestamptz`:
  /// "day 2 of the trip" is a day on the traveler's itinerary, not an
  /// instant in UTC that could shift when rendered in another timezone.
  itineraryDay DateTime @map("itinerary_day") @db.Date
  /// "HH:MM" 24-hour local time. A CHECK constraint in the phase's SQL
  /// file enforces the format at the database level.
  startTime    String?  @map("start_time")
  endTime      String?  @map("end_time")

  title         String
  itemType      ItineraryItemType   @default(OTHER) @map("item_type")
  location      String?
  destinationId String?             @map("destination_id")
  notes         String?

  estimatedCost Decimal? @map("estimated_cost") @db.Decimal(12, 2)
  currency      String?  @db.Char(3)

  source    ItineraryItemSource @default(USER)
  /// Groups the rows one planning run produced, so a re-run's replacement
  /// is auditable after the fact rather than an unexplained diff.
  planRunId String?             @map("plan_run_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  trip        Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  destination Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)

  @@index([tripId, itineraryDay, startTime])
  @@map("itinerary_items")
}

/// Trip Watch's scheduling state (Phase 19). One row per watched trip.
///
/// Kept in its own table rather than as columns on Trip for the same
/// reason the snapshot tables are separate: this is state about the
/// *watching*, not about the trip, and an unwatched trip simply has no
/// row here (no nullable "is it watched" column to interpret).
///
/// `last_run_at` / `last_error` / `next_run_at` are the whole of the
/// scheduler's memory, and they are exactly what the sweep reports —
/// nothing about a pass is inferred or reconstructed after the fact.
model TripWatch {
  id               String       @id @default(uuid())
  tripId           String       @unique @map("trip_id")
  enabled          Boolean      @default(true)
  /// Cadence. Bounded in the service (5..1440 minutes) and by a CHECK
  /// constraint applied with the table, so no code path can schedule a
  /// paid provider poll every second.
  intervalMinutes  Int          @default(60) @map("interval_minutes")
  /// Don't interrupt the traveler below this severity. MEDIUM is the
  /// default and is behaviour-preserving: a meaningful change cannot
  /// occur while the score is still in LOW.
  alertMinSeverity RiskSeverity @default(MEDIUM) @map("alert_min_severity")
  lastRunAt        DateTime?    @map("last_run_at")
  /// The failure of the most recent pass, cleared by the next success.
  lastError        String?      @map("last_error")
  nextRunAt        DateTime     @default(now()) @map("next_run_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  /// The sweep's own access path: "which enabled watches are due?"
  @@index([enabled, nextRunAt])
  @@map("trip_watches")
}

model AuditLog {
  id         String    @id @default(uuid())
  actorType  ActorType @map("actor_type")
  /// User id, agent name ("flight_agent"), or null for unattributed
  /// system actions -- deliberately not a foreign key, since agent/system
  /// actors aren't rows in the users table.
  actorId    String?   @map("actor_id")
  action     String
  entityType String    @map("entity_type")
  entityId   String    @map("entity_id")
  metadata   Json?
  /// Correlates with the requestId emitted by withApiHandler
  /// (src/shared/api-response.ts) and with structured log lines --
  /// one id ties together a log line, an API response, and an audit row.
  requestId  String?   @map("request_id")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([requestId])
  @@map("audit_logs")
}

model ApiHealth {
  id                  String          @id @default(uuid())
  provider            String          @unique
  status              ApiHealthStatus @default(OPERATIONAL)
  lastCheckedAt       DateTime        @map("last_checked_at")
  lastSuccessAt       DateTime?       @map("last_success_at")
  lastFailureAt       DateTime?       @map("last_failure_at")
  consecutiveFailures Int             @default(0) @map("consecutive_failures")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  @@map("api_health")
}
